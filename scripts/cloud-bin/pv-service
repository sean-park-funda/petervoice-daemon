#!/usr/bin/env bash
# pv-service — 피터보이스 클라우드 컨테이너의 상시 서비스(웹서버·봇·터널 연결기) 관리
#
# 대화 턴이 끝나도 컨테이너는 켜져 있지만, 그냥 `&` 로 띄운 프로세스는 컨테이너 재기동·재생성·
# 호스트 재부팅 때 사라진다. 여기 등록한 서비스는 클라우드 데몬이 기동 시와 5분마다
# `pv-service up` 으로 되살린다.
#
# 상태: ~/.pv/services/<이름>/{cmd,pid,log,disabled}
set -uo pipefail

ROOT="${HOME}/.pv/services"
mkdir -p "$ROOT"
chmod 700 "${HOME}/.pv" 2>/dev/null || true

usage() {
  cat <<'EOF'
pv-service add <이름> [--cwd 폴더] -- <실행 명령...>   등록하고 시작 (같은 이름이면 교체)
pv-service start|stop|restart <이름>                  stop 한 서비스는 자동으로 되살리지 않는다
pv-service rm <이름>                                  중지 후 등록 삭제
pv-service list                                       등록 목록과 상태
pv-service logs <이름> [줄수]                          로그 끝부분 (기본 100줄)
pv-service up                                         중지하지 않은 서비스 중 꺼진 것 모두 시작
EOF
}

die() { echo "$*" >&2; exit 2; }
valid_name() { [[ "${1:-}" =~ ^[a-z0-9][a-z0-9_-]{0,39}$ ]] || die "이름은 영문 소문자·숫자·-·_ (최대 40자): '${1:-}'"; }
pid_of() { [ -f "$ROOT/$1/pid" ] && cat "$ROOT/$1/pid"; }
is_running() { local p; p=$(pid_of "$1"); [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

start_one() {
  local n="$1" d="$ROOT/$1"
  [ -f "$d/cmd" ] || { echo "등록되지 않은 서비스: $n" >&2; return 1; }
  rm -f "$d/disabled"
  if is_running "$n"; then echo "$n: 이미 실행 중 (pid $(pid_of "$n"))"; return 0; fi
  if [ -f "$d/log" ] && [ "$(stat -c %s "$d/log" 2>/dev/null || echo 0)" -gt 10485760 ]; then
    mv -f "$d/log" "$d/log.1"
  fi
  # setsid: 턴(claude)의 프로세스 그룹에서 떼어내 턴이 끝나도 살아남게 하고, 중지 시 그룹째 끈다
  ( setsid bash "$d/cmd" >>"$d/log" 2>&1 </dev/null & echo $! >"$d/pid" )
  sleep 1
  if is_running "$n"; then
    echo "$n: 시작 (pid $(pid_of "$n"))"
  else
    echo "$n: 시작 직후 종료됨 — 로그:" >&2
    tail -n 20 "$d/log" >&2
    return 1
  fi
}

stop_one() {
  local n="$1" d="$ROOT/$1" p
  [ -d "$d" ] || { echo "등록되지 않은 서비스: $n" >&2; return 1; }
  touch "$d/disabled"
  p=$(pid_of "$n")
  if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
    kill -TERM -- "-$p" 2>/dev/null || kill -TERM "$p" 2>/dev/null
    for _ in $(seq 1 20); do kill -0 "$p" 2>/dev/null || break; sleep 0.5; done
    kill -0 "$p" 2>/dev/null && { kill -KILL -- "-$p" 2>/dev/null || kill -KILL "$p" 2>/dev/null; }
  fi
  rm -f "$d/pid"
  echo "$n: 중지"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  add)
    n="${1:-}"; valid_name "$n"; shift
    cwd="$PWD"
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
      case "$1" in
        --cwd) cwd="${2:-}"; shift 2 ;;
        *) die "알 수 없는 옵션: $1 (명령 앞에 -- 를 넣으세요)" ;;
      esac
    done
    [ "${1:-}" = "--" ] || die "사용법: pv-service add <이름> [--cwd 폴더] -- <실행 명령...>"
    shift
    [ $# -gt 0 ] || die "실행 명령이 비어 있습니다"
    [ -d "$cwd" ] || die "폴더가 없습니다: $cwd"
    cwd=$(cd "$cwd" && pwd)
    d="$ROOT/$n"
    [ -d "$d" ] && is_running "$n" && stop_one "$n" >/dev/null
    mkdir -p "$d"
    {
      echo '#!/usr/bin/env bash'
      # 데몬이 되살릴 때는 이 셸의 PATH(nvm·venv 등)가 없다 — 등록 시점 PATH 를 고정
      printf 'export PATH=%q\n' "$PATH"
      printf 'cd %q || exit 1\n' "$cwd"
      printf 'exec'; printf ' %q' "$@"; echo
    } >"$d/cmd"
    chmod 700 "$d/cmd"
    start_one "$n"
    ;;
  start) valid_name "${1:-}"; start_one "$1" ;;
  stop) valid_name "${1:-}"; stop_one "$1" ;;
  restart) valid_name "${1:-}"; stop_one "$1" >/dev/null; start_one "$1" ;;
  rm)
    valid_name "${1:-}"
    [ -d "$ROOT/$1" ] || die "등록되지 않은 서비스: $1"
    stop_one "$1" >/dev/null; rm -rf "${ROOT:?}/$1"; echo "$1: 삭제"
    ;;
  list)
    found=0
    for d in "$ROOT"/*/; do
      [ -f "$d/cmd" ] || continue
      found=1; n=$(basename "$d")
      if is_running "$n"; then st="실행 중 (pid $(pid_of "$n"))"
      elif [ -f "$d/disabled" ]; then st="중지됨"
      else st="꺼짐 (자동으로 다시 시작됨)"; fi
      printf '%-20s %s\n    %s\n' "$n" "$st" "$(tail -n 1 "$d/cmd")"
    done
    [ $found = 1 ] || echo "등록된 서비스 없음"
    ;;
  logs)
    valid_name "${1:-}"
    [ -f "$ROOT/$1/log" ] || die "로그 없음: $1"
    tail -n "${2:-100}" "$ROOT/$1/log"
    ;;
  up)
    rc=0
    for d in "$ROOT"/*/; do
      [ -f "$d/cmd" ] || continue
      n=$(basename "$d")
      [ -f "$d/disabled" ] && continue
      is_running "$n" || start_one "$n" || rc=1
    done
    exit $rc
    ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
